# ---------------------------------------------------------------------------
# mtproto-platform -- example environment
#
# Copy to `.env` for local development:   cp .env.example .env
# `.env` is git-ignored and must never be committed.
#
# Every variable below is read by src/core/config.py (Pydantic Settings).
# Matching is case-insensitive. Variables added by later tasks (tester
# timeouts, scoring interval, Telegram publisher, AI content provider) are
# intentionally NOT listed yet -- see docs/DECISION_LOG.md.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
# One of: development | staging | production
# production additionally *requires* a real DATABASE_URL and forbids DB_ECHO.
ENV=development

# CRITICAL | ERROR | WARNING | INFO | DEBUG
LOG_LEVEL=INFO

# Level for third-party loggers (asyncio, SQLAlchemy, Telethon, asyncpg).
# Kept separate so application DEBUG does not drown structured events in noise.
THIRD_PARTY_LOG_LEVEL=WARNING

# json | console   (empty = console in development, json in staging/production)
LOG_FORMAT=

# Overridden per process by the worker entrypoints; useful when running by hand.
WORKER_NAME=unset

# --- Database (Task 002) ---------------------------------------------------
# PostgreSQL only. The async driver is normalised automatically, so both
# `postgresql://` and `postgresql+asyncpg://` are accepted; a bare
# `postgresql://` would otherwise resolve to psycopg2, which is not installed.
#
# No Docker is required. To provision a local PostgreSQL 16 with the `mtproto`
# and `mtproto_test` databases already created:
#
#   uv run --with pgserver python scripts/dev_pg.py up
#   uv run --with pgserver python scripts/dev_pg.py run -- uv run pytest -m integration
#
# That prints the exact DATABASE_URL/TEST_DATABASE_URL to export (it uses a Unix
# socket under $XDG_CACHE_HOME, not localhost:5432). Any other PostgreSQL works
# too -- Supabase, Neon, RDS or a system package. See docs/DATABASE.md.
#
# The values below are a placeholder for a conventional TCP install and are
# development-only credentials, not secrets.
DATABASE_URL=postgresql+asyncpg://mtproto:mtproto@localhost:5432/mtproto

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800

# Validate pooled connections before handing them out. A stale connection would
# otherwise surface as an InterfaceError deep inside a worker loop; pre-ping turns
# that into a transparent reconnect. Costs one round trip per checkout.
DB_POOL_PRE_PING=true

# Keep bind parameters out of SQLAlchemy exception messages. This schema stores an
# MTProto secret in plaintext, so a failing INSERT would otherwise put it in an
# exception string that gets logged and persisted. Set to false only while
# debugging a query locally; never in production. See docs/DATABASE.md#secrets.
DB_HIDE_PARAMETERS=true

# Never enable in production: SQL echoing can leak data into logs.
DB_ECHO=false

# Separate DSN for the `integration` test suite. The migration lifecycle test runs
# `alembic downgrade base`, which DROPS EVERY TABLE, so it must never point at a
# working database by accident.
#
# When unset it is *derived* from DATABASE_URL by suffixing the database name with
# `_test` (query parameters such as `?host=<socket dir>` are preserved), and it is
# already `_test`-suffixed it is left alone. Under ENV=production derivation is
# REFUSED and this variable becomes mandatory -- a production database must never
# become a test target by inference.
#TEST_DATABASE_URL=postgresql+asyncpg://mtproto:mtproto@localhost:5432/mtproto_test

# --- Worker lifecycle ------------------------------------------------------
# Grace period allowed for in-flight work after a stop signal.
SHUTDOWN_GRACE_SECONDS=10

# How often each worker emits a `worker_heartbeat` structured log event.
HEARTBEAT_INTERVAL_SECONDS=60

# Idle delay between ticks. Each worker narrows this in its own task.
WORKER_POLL_INTERVAL_SECONDS=5

# Backoff applied after a failing tick (doubles per consecutive failure).
WORKER_ERROR_BACKOFF_SECONDS=2
WORKER_MAX_ERROR_BACKOFF_SECONDS=60

# --- Telegram API & Tester (Task 004) --------------------------------------
# Real credentials from https://my.telegram.org. Required to run the tester worker
# or live tests. Never commit real credentials.
#TELEGRAM_API_ID=123456
#TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef

TESTER_CONCURRENCY=10
TESTER_TCP_TIMEOUT_SECONDS=3.0
TESTER_MTPROTO_TIMEOUT_SECONDS=8.0
TESTER_TOTAL_TIMEOUT_SECONDS=15.0
TESTER_BATCH_SIZE=25

# --- Scorer (Task 005) -----------------------------------------------------
# Formula constants (half-life, weights, Laplace prior) are code, not env,
# so scoring_version=v1 stays comparable. This is only the per-tick batch size.
SCORER_BATCH_SIZE=50
